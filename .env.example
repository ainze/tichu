# Template for docker-compose.prod.yml. Copy to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.

# --- Container registry + image tags (AWS ECR) -------------------------------
REGISTRY=746783052363.dkr.ecr.eu-west-1.amazonaws.com
NUXT_TAG=20260608b
INFERENCE_TAG=cotrain_wish_v5

# --- Nuxt backend (tichu_production) -----------------------------------------
# Postgres connection string. The sslrootcert path must match the .pem mounted
# in docker-compose.prod.yml. URL-encode special chars in the password.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tichu?sslmode=verify-full&sslrootcert=/etc/ssl/rds-global-bundle.pem

# Better Auth: a long random secret, and the public site URL.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://tichu.inzelabs.com

# Bot API auth token (the inference service currently does not require one).
BOT_API_TOKEN=none

# NOTE: BOT_API_URL is intentionally NOT here — it is hardcoded to the in-network
# service name (http://tichu-inference:8000) in docker-compose.prod.yml and must
# not be overridden to localhost.
